[
  {
    "name": "ASPNETCORE_ENVIRONMENT",
    "value": "${ENVIRONMENT}",
    "slotSetting": false
  },
  {
    "name": "Logging__LogLevel__Default",
    "value": "${LOG_LEVEL}",
    "slotSetting": false
  },
  {
    "name": "FeatureFlags__NewCheckout",
    "value": "${FEATURE_NEW_CHECKOUT}",
    "slotSetting": false
  },

  {
    "_comment": "SECRETS below are Key Vault REFERENCES. The pipeline never sees the raw value; App Service resolves them at runtime via its managed identity. Rotate in Key Vault with zero pipeline changes.",

    "name": "OrdersDb__ConnectionString",
    "value": "@Microsoft.KeyVault(SecretUri=https://${KEYVAULT_NAME}.vault.azure.net/secrets/orders-db-connection/)",
    "slotSetting": false
  },
  {
    "name": "ServiceBus__ConnectionString",
    "value": "@Microsoft.KeyVault(SecretUri=https://${KEYVAULT_NAME}.vault.azure.net/secrets/orders-servicebus/)",
    "slotSetting": false
  }
]
